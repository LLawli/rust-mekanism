  "constants.mekanismgenerators.mod_name": "Mekanism: Generators",
  "description.mekanismgenerators.advanced_solar_generator": "An advanced generator that directly absorbs the sun's rays with little loss to produce energy.",
  "description.mekanismgenerators.bio_generator": "A generator that burns organic materials of the world to produce energy.",
  "description.mekanismgenerators.control_rod_assembly": "A collection of control rods used to halt a fission chain reaction. Placed on top of a tower of Fission Fuel Assemblies.",
  "description.mekanismgenerators.electromagnetic_coil": "A block that converts kinetic energy from a Rotational Complex into usable electricity. These can be placed in any arrangement above your Rotational Complex, as long as they are all touching each other and the complex itself.",
  "description.mekanismgenerators.fission_fuel_assembly": "A cluster of fuel rods used to house fission fuel within a Fission Reactor. These can be stacked on top of each other.",
  "description.mekanismgenerators.fission_reactor_casing": "Lead-infused steel casing used to create a Fission Reactor. Mostly heat-resistant, mostly radiation-resistant, and mostly safe!",
  "description.mekanismgenerators.fission_reactor_logic_adapter": "A block that can be used to monitor or control the Fission Reactor with redstone.",
  "description.mekanismgenerators.fission_reactor_port": "A port which can be placed on a Fission Reactor multiblock to transfer coolant, fuel, and waste.",
  "description.mekanismgenerators.fusion_reactor_controller": "The controlling block for the entire Fusion Reactor structure.",
  "description.mekanismgenerators.fusion_reactor_frame": "Reinforced framing that can be used in the Fusion Reactor multiblock.",
  "description.mekanismgenerators.fusion_reactor_logic_adapter": "A block that can be used to allow basic monitoring of a Fusion Reactor using redstone.",
  "description.mekanismgenerators.fusion_reactor_port": "A block of reinforced framing that is capable of managing both the chemical and energy transfer of the Fusion Reactor.",
  "description.mekanismgenerators.gas_burning_generator": "A generator that harnesses the varying molecular gases to produce energy.",
  "description.mekanismgenerators.heat_generator": "A generator that uses the heat of lava or other burnable resources to produce energy.",
  "description.mekanismgenerators.laser_focus_matrix": "A panel of Fusion Reactor Glass that is capable of absorbing optical energy and thereby heating up the Fusion Reactor.",
  "description.mekanismgenerators.reactor_glass": "Reinforced glass that can be used in the Fission Reactor and Fusion Reactor multiblocks (as well as any others!).",
  "description.mekanismgenerators.rotational_complex": "A connector that is placed on the highest Turbine Rotor of an Industrial Turbine to carry kinetic energy into its Electromagnetic Coils.",
  "description.mekanismgenerators.saturating_condenser": "A block that condenses steam processed by an Industrial Turbine into reusable water. These can be placed in any arrangement above your rotational complex.",
  "description.mekanismgenerators.solar_generator": "A generator that uses the power of the sun to produce energy.",
  "description.mekanismgenerators.turbine_casing": "Pressure-resistant casing used in the creation of an Industrial Turbine.",
  "description.mekanismgenerators.turbine_rotor": "The steel rod that is used to house Turbine Blades within an Industrial Turbine.",
  "description.mekanismgenerators.turbine_valve": "A type of Turbine Casing that includes a port for the transfer of energy and steam.",
  "description.mekanismgenerators.turbine_vent": "A type of Turbine Casing with an integrated vent for the release of steam. These should be placed on the level of or above the turbine's Rotational Complex.",
  "description.mekanismgenerators.wind_generator": "A generator that uses the strength of the wind to produce energy, with greater efficiency at higher levels.",
  "item.mekanismgenerators.hohlraum": "Hohlraum",
  "item.mekanismgenerators.solar_panel": "Solar Panel",
  "item.mekanismgenerators.turbine_blade": "Turbine Blade"
 },
